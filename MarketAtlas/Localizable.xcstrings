          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "순위, 비교, 매출 추이를 일상적인 말로 물어보세요. 입력하거나 말하세요."
          }
        },
        "es": {
          "stringUnit": {
