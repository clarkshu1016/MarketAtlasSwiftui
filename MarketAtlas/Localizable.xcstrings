    "Every country and sector on one screen. Tile size is market cap, colour is the change.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての国とセクターを1画面に。タイルの大きさは時価総額、色は値動きです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有国家和行业，一屏尽览。方块大小代表市值，颜色代表涨跌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有國家和產業，一屏盡覽。方塊大小代表市值，顏色代表漲跌。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 화면에 모든 국가와 섹터를 담았습니다. 타일 크기는 시가총액, 색상은 변동률입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los países y sectores en una sola pantalla. El tamaño del recuadro es la capitalización y el color, la variación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Länder und Sektoren auf einem Bildschirm. Die Kachelgröße zeigt die Marktkapitalisierung, die Farbe die Veränderung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les pays et secteurs sur un seul écran. La taille de la tuile représente la capitalisation, la couleur la variation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os países e setores em uma única tela. O tamanho do bloco é o valor de mercado; a cor, a variação."
          }
        }
      }
    },
