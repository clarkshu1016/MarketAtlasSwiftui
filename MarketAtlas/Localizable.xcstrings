    "See how the world's biggest companies overtook each other, from 2000 to today.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2000年から現在まで、世界の大企業が順位を入れ替える様子をご覧ください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看全球最大的公司如何从 2000 年至今不断超越、易位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看全球最大的公司如何從 2000 年至今不斷超越、易位。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2000년부터 지금까지 세계 최대 기업들이 서로 순위를 바꾸는 모습을 확인해 보세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira cómo las mayores empresas del mundo se han ido adelantando unas a otras, de 2000 a hoy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, wie die größten Unternehmen der Welt einander überholt haben, von 2000 bis heute."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez comment les plus grandes entreprises du monde se sont dépassées, de 2000 à aujourd’hui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja como as maiores empresas do mundo se ultrapassaram, de 2000 até hoje."
          }
        }
      }
    },
