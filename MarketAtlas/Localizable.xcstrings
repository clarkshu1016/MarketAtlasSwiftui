    "Permanently deletes your account and all associated data. This cannot be undone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントと関連するすべてのデータを完全に削除します。この操作は取り消せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将永久删除您的账户及所有相关数据，此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將永久刪除您的帳號及所有相關資料，此操作無法復原。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정과 관련된 모든 데이터가 영구적으로 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina de forma permanente tu cuenta y todos los datos asociados. No se puede deshacer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht deinen Account und alle zugehörigen Daten dauerhaft. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement votre compte et toutes les données associées. Cette action est irréversible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui permanentemente sua conta e todos os dados associados. Esta ação não pode ser desfeita."
          }
        }
      }
    },
