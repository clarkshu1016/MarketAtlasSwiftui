    "Sign in to save and sync your favourite companies across devices.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインすると、お気に入りの企業をデバイス間で保存・同期できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后即可跨设备保存并同步您收藏的公司。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入後即可跨裝置儲存並同步您收藏的公司。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하면 즐겨찾는 기업을 저장하고 여러 기기에서 동기화할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para guardar y sincronizar tus empresas favoritas en todos tus dispositivos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich an, um deine Favoriten zu speichern und auf allen Geräten zu synchronisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour enregistrer et synchroniser vos entreprises favorites sur tous vos appareils."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre para salvar e sincronizar suas empresas favoritas em todos os dispositivos."
          }
        }
      }
    },
    "Sign in to save favourites across your devices.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインして、お気に入りをデバイス間で保存します。"
          }
        },
