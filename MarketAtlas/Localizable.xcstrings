            "value": "対数目盛のため、同じ変化率は同じ傾きで表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采用对数坐标，相同的涨跌幅在图上斜率一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "採用對數座標，相同的漲跌幅在圖上斜率一致。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그 스케일이므로 같은 비율의 변동은 같게 보입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escala logarítmica: las mismas variaciones porcentuales se ven iguales."
          }
        },
