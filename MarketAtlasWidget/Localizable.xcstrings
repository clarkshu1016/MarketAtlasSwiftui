{
  "sourceLanguage": "en",
  "strings": {
    "Can't load data": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データを読み込めません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入資料"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터를 불러올 수 없음"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden cargar los datos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten können nicht geladen werden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les données"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar os dados"
          }
        }
      }
    },
    "The world's largest companies by market cap, with today's move.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界最大級の企業を時価総額順に表示し、本日の値動きも確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按市值显示全球最大的公司及今日涨跌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依市值顯示全球最大的公司及今日漲跌。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시가총액 기준 세계 최대 기업과 오늘의 변동을 보여줍니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las mayores empresas del mundo por capitalización, con su variación de hoy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die größten Unternehmen der Welt nach Marktkapitalisierung mit der heutigen Veränderung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plus grandes entreprises du monde par capitalisation, avec la variation du jour."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As maiores empresas do mundo por valor de mercado, com a variação de hoje."
          }
        }
      }
    },
